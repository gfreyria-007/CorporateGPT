{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json"],
    "rewrites": [
      {
        "source": "/api/health",
        "destination": "/health.json"
      },
      {
        "source": "/api/techie",
        "function": "techie"
      },
      {
        "source": "/api/models",
        "function": "models"
      },
      {
        "source": "/api/gemini",
        "function": "gemini"
      }
    ]
  }
}
